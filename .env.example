# Copy to .env. All values are for local demo use only.
DEMO_MODE=true

CRED_API_URL=http://localhost:4000
ECOSYSTEM_API_URL=http://localhost:4100

# Shared secret ecosystem-api uses to sign webhooks to cred-api (HMAC-SHA256)
WEBHOOK_SECRET_ECOSYSTEM=dev-webhook-secret-change-me
# API key cred-api presents when calling ecosystem-api partner endpoints
PARTNER_API_KEY_CRED=dev-partner-key-change-me
# Signs demo member session tokens
SESSION_SECRET=dev-session-secret-change-me

# ShopKart merchant key for the gateway
SHOPKART_MERCHANT_KEY=dev-shopkart-key-change-me
