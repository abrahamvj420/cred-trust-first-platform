// cred.db: what CRED legitimately knows. Everything here arrived through
// the member, a signed partner webhook, or a consented Account Aggregator pull.
//
// Conventions
// - Money is Int paise. Rates are Int basis points.
// - Status/kind fields are String, validated by Zod enums in @cred/types.
// - *Json fields are String holding JSON, validated by Zod on read.
// - Calendar dates (no time) are String "YYYY-MM-DD"; instants are DateTime.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/cred"
}

datasource db {
  provider = "sqlite"
}

model Member {
  id          String    @id @default(cuid())
  personaKey  String    @unique
  name        String
  phone       String    @unique
  city        String
  age         Int
  vpa         String
  memberSince String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  cards             Card[]
  upiTransactions   UpiTransaction[]
  permissions       Permission[]
  aaConsents        AaConsent[]
  income            IncomeProfile?
  holdings          Holding[]
  goals             Goal[]
  familyMembers     FamilyMember[]
  policies          InsurancePolicy[]
  activitySummaries ActivitySummary[]
  wearableLink      WearableLink?
  ladder            LadderProgress?
  decisions         EngineDecision[]
  offers            Offer[]
  loans             Loan[]
  helpPlans         HelpPlan[]
  sellIntents       SellIntent[]
  events            DomainEvent[]
  audit             AuditLog[]
  rewards           RewardEntry[]
  alerts            MemberAlert[]
  complaints        Complaint[]
}

/// A concern the member raised; admin resolves it with a note back to them
model Complaint {
  id         String    @id @default(cuid())
  memberId   String
  /// offer | data_privacy | claim | payment | loan | other
  category   String
  message    String
  offerId    String?
  /// open | resolved
  status     String    @default("open")
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Every call CRED made to a partner (lender, insurer, AA, bank …), for the admin partner log
model PartnerCall {
  id       String   @id @default(cuid())
  partner  String
  method   String
  path     String
  status   Int
  ms       Int
  memberId String?
  at       DateTime @default(now())

  @@index([at])
}

/// CRED staff who can sign in to the console (demo account seeded)
model StaffUser {
  id           String   @id
  email        String   @unique
  name         String
  /// scrypt: salt:hash (hex)
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Rule settings changed from admin; anything absent uses the engine default
model RuleSetting {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

/// Information for the member (market moves, claim updates, tier changes). Never an offer.
model MemberAlert {
  id        String    @id @default(cuid())
  memberId  String
  kind      String
  title     String
  body      String
  href      String?
  /// e.g. the partner event that raised it; unique so a re-sent event never doubles an alert
  sourceRef String?   @unique
  readAt    DateTime?
  simDate   String    @default("")
  createdAt DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

/// Coins ledger: balance is the sum of entries
model RewardEntry {
  id          String   @id @default(cuid())
  memberId    String
  /// earned | redeemed | opening
  kind        String
  coins       Int
  description String
  /// e.g. the bill payment that earned it; unique so nothing is credited twice
  sourceRef   String?  @unique
  voucherCode String?
  at          DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, at])
}

model Card {
  id               String @id @default(cuid())
  memberId         String
  issuerName       String
  network          String
  last4            String
  limitPaise       Int
  outstandingPaise Int    @default(0)
  billingDay       Int
  dueDay           Int
  /// Bank's customer and card ids, as sent in webhooks
  customerRef      String
  cardRef          String @unique

  member       Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transactions CardTransaction[]
  statements   Statement[]
}

model CardTransaction {
  id          String   @id @default(cuid())
  cardId      String
  externalRef String   @unique
  merchant    String
  category    String
  amountPaise Int
  postedAt    DateTime

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, postedAt])
}

model Statement {
  id            String @id @default(cuid())
  cardId        String
  externalRef   String @unique
  periodStart   String
  periodEnd     String
  totalDuePaise Int
  minDuePaise   Int
  paidPaise     Int    @default(0)
  dueDate       String
  /// open | paid | partial | unpaid | overdue
  status        String @default("open")
  interestPaise Int    @default(0)
  /// Sim date the due date was applied (null = not yet due)
  settledOn     String?
  /// paid_in_full | part_paid | missed, set when the due date passes (credit ladder)
  ladderOutcome String?

  card     Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  payments BillPayment[]

  @@index([cardId, periodEnd])
}

model BillPayment {
  id          String   @id @default(cuid())
  statementId String
  externalRef String?  @unique
  /// full | minimum | custom
  kind        String
  /// upi | netbanking (null for history before CRED tracked it)
  source      String?
  amountPaise Int
  paidAt      DateTime
  onTime      Boolean

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}

model UpiTransaction {
  id          String   @id @default(cuid())
  memberId    String
  upiTxnRef   String?  @unique
  payerVpa    String
  payeeVpa    String
  payeeName   String?
  amountPaise Int
  note        String?
  /// awaiting_pin | success | failed
  status      String
  rrn         String?
  failureReason String?
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String    @id @default(cuid())
  memberId    String
  /// smart_savings | income_data | health_data | portfolio_data
  scope       String
  /// granted | withdrawn
  status      String
  context     String?
  grantedAt   DateTime?
  withdrawnAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, scope])
}

model AaConsent {
  id            String    @id @default(cuid())
  memberId      String
  consentHandle String    @unique
  consentId     String?   @unique
  /// income_verification | portfolio_tracking | protection_review
  purpose       String
  fiTypesJson   String
  /// PENDING | ACTIVE | REJECTED | REVOKED | EXPIRED
  status        String
  /// Where the member goes back to in the app after the AA page
  returnTo      String    @default("/")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  lastFetchedAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model IncomeProfile {
  memberId        String   @id
  monthlyNetPaise Int
  employer        String
  monthsVerified  Int
  verifiedAt      DateTime
  consentId       String

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Holding {
  id                String  @id @default(cuid())
  memberId          String
  /// mutual_fund | fixed_deposit | gold
  kind              String
  name              String
  provider          String
  /// Fund folio / FD ref, used when instructing the provider
  externalRef       String
  schemeCode        String?
  units             Float?
  /// Units pledged to a lender (loan against holdings)
  pledgedUnits      Float   @default(0)
  /// equity | debt | hybrid | gold | fixed_deposit
  assetClass        String  @default("equity")
  /// aa | self_declared
  source            String  @default("aa")
  valuePaise        Int
  costPaise         Int
  acquiredAt        String
  expenseRatioBps   Int?
  expectedReturnBps Int
  sourceConsentId   String?

  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sellIntents SellIntent[]

  @@unique([memberId, externalRef, schemeCode])
}

model SellIntent {
  id                String   @id @default(cuid())
  memberId          String
  holdingId         String
  amountNeededPaise Int
  months            Int
  decisionId        String?
  offerId           String?
  redemptionRef     String?
  comparisonJson    String
  /// open | sold | borrowed | abandoned
  status            String   @default("open")
  createdAt         DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  holding Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
}

model Goal {
  id               String   @id @default(cuid())
  memberId         String
  name             String
  targetPaise      Int
  targetDate       String
  currentPaise     Int      @default(0)
  assumedReturnBps Int
  createdAt        DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id       String @id @default(cuid())
  memberId String
  name     String
  /// self | spouse | child | parent | parent_in_law
  relation String
  age      Int

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model InsurancePolicy {
  id                  String  @id @default(cuid())
  memberId            String
  externalRef         String  @unique
  insurerName         String
  productName         String
  /// health_individual | health_family_floater | employer_group_health | term_life
  kind                String
  coverPaise          Int
  deductiblePaise     Int     @default(0)
  annualPremiumPaise  Int
  isEmployer          Boolean @default(false)
  employerName        String?
  membersCoveredJson  String
  renewalDate         String?
  /// aa | cred_purchase
  source              String
  vehicleJson         String?
  /// The offer it was bought through (cred_purchase)
  offerId             String?
  /// Insurer proposal while awaiting OTP confirmation
  proposalRef         String?  @unique
  /// active | proposed
  status              String  @default("active")
  wellnessSavedPaise  Int     @default(0)
  lastRenewedOn       String?
  lastPremiumPaidPaise Int?

  member Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  claims Claim[]
}

model Claim {
  id           String   @id @default(cuid())
  policyId     String
  externalRef  String?  @unique
  amountPaise  Int
  description  String
  status       String
  timelineJson String
  createdAt    DateTime @default(now())

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

/// Weekly summaries only. CRED never holds raw step data.
model ActivitySummary {
  id            String @id @default(cuid())
  memberId      String
  weekStart     String
  avgDailySteps Int
  activeDays    Int
  score         Int

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekStart])
}

model WearableLink {
  memberId    String   @id
  provider    String
  linkRef     String   @unique
  customerRef String
  linkedAt    DateTime

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model LadderProgress {
  memberId     String @id
  /// starter | silver | gold | platinum
  tier         String
  onTimeStreak Int

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model EngineDecision {
  id              String   @id @default(cuid())
  memberId        String
  feature         String
  /// proactive | member_initiated
  origin          String
  triggerEventId  String?
  /// offer | blocked | help
  outcome         String
  reasonsJson     String
  checksJson      String
  stressJson      String
  netBenefitPaise Int?
  /// Plain-English why / why not, shown to the member and in admin
  explanation     String   @default("")
  /// Simulated calendar date of the decision
  simDate         String   @default("")
  createdAt       DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  offer  Offer?

  @@index([memberId, createdAt])
}

model Offer {
  id              String    @id @default(cuid())
  memberId        String
  decisionId      String    @unique
  feature         String
  origin          String
  /// awaiting_permission | shown | accepted | declined | expired
  status          String
  headline        String
  subline         String
  netBenefitPaise Int
  /// What the saving is measured against, e.g. "less than card interest"
  benefitLabel    String    @default("")
  /// Feature context needed on accept (holding pledged, people insured, sell intent …)
  contextJson     String    @default("{}")
  comparisonJson  String
  optionsJson     String    @default("[]")
  termsJson       String
  triggerJson     String?
  /// Plain-English "why am I seeing this"
  why             String    @default("")
  /// The trigger (e.g. card transaction ref) — an offer is never repeated for it
  triggerRef      String?
  /// Partner quote per acceptable option, e.g. {"emi":"q_..","loan":"q_.."}
  quoteRefsJson   String    @default("{}")
  simDate         String    @default("")
  createdAt       DateTime  @default(now())
  /// First time the member saw it (null while awaiting Smart Savings)
  shownAt         DateTime?
  decidedAt       DateTime?
  decidedSimDate  String?

  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  decision EngineDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  loan     Loan?

  @@index([memberId, status])
}

model Loan {
  id                String   @id @default(cuid())
  memberId          String
  offerId           String?  @unique
  applicationRef    String   @unique
  loanRef           String?  @unique
  kind              String
  /// emi | loan: which offer option was accepted
  option            String?
  lenderName        String
  principalPaise    Int
  ratePaBps         Int
  tenureMonths      Int
  emiPaise          Int
  processingFeePaise Int
  /// Loan against holdings: what is pledged
  collateralJson    String?
  /// Interest no longer paid because of early repayments
  interestSavedPaise Int     @default(0)
  /// applied | approved | declined | disbursed | closed
  status            String
  createdAt         DateTime @default(now())

  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  offer        Offer?           @relation(fields: [offerId], references: [id])
  installments EmiInstallment[]
}

model EmiInstallment {
  id             String @id @default(cuid())
  loanId         String
  n              Int
  dueDate        String
  amountPaise    Int
  principalPaise Int
  interestPaise  Int
  /// upcoming | paid | overdue
  status         String @default("upcoming")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, n])
}

/// Repayment help shown to stressed members in place of credit
model HelpPlan {
  id          String   @id @default(cuid())
  memberId    String
  decisionId  String?
  kind        String
  title       String
  body        String
  monthlyInterestPaise Int?
  simDate     String   @default("")
  dismissedAt DateTime?
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// Every partner webhook received, for idempotency and the admin log
model InboundWebhook {
  eventId     String   @id
  partner     String
  type        String
  signatureOk Boolean
  duplicateCount Int   @default(0)
  payloadJson String
  memberId    String?
  receivedAt  DateTime @default(now())

  @@index([receivedAt])
}

/// Internal event log; feeds the member SSE stream and the admin live view
model DomainEvent {
  id          String   @id @default(cuid())
  memberId    String?
  type        String
  payloadJson String
  createdAt   DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  memberId    String?
  /// member | admin | system | partner
  actor       String
  action      String
  target      String?
  detailsJson String   @default("{}")
  at          DateTime @default(now())

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([action, at])
}

/// Mirror of the world clock, updated by sim.clock.advanced webhooks
model SimState {
  id          Int    @id @default(1)
  currentDate String
}
